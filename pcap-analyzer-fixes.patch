diff --git a/pcap_glass_ui.py b/pcap_glass_ui.py
index fbbe882..e31bd82 100644
--- a/pcap_glass_ui.py
+++ b/pcap_glass_ui.py
@@ -32,8 +32,37 @@ PAL = {
 
 
 def hex2rgb(h):
-    h = h.lstrip("#")
-    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
+    """Colour → (r, g, b). Accepts '#rrggbb', '#rgb', and Tk colour names.
+
+    On Windows ``widget.cget("bg")`` can return a system colour name such as
+    ``SystemButtonFace`` instead of a hex string, so names are resolved through Tk.
+    """
+    if isinstance(h, (tuple, list)) and len(h) >= 3:
+        return tuple(int(v) for v in h[:3])
+    h = str(h or "").strip()
+    if h.startswith("#"):
+        x = h[1:]
+        if len(x) == 3:
+            x = "".join(c * 2 for c in x)
+        if len(x) == 12:                      # #rrrrggggbbbb
+            x = x[0:2] + x[4:6] + x[8:10]
+        try:
+            if len(x) >= 6:
+                return tuple(int(x[i:i + 2], 16) for i in (0, 2, 4))
+        except ValueError:
+            pass
+    else:
+        try:
+            import tkinter as _tk
+            root = getattr(_tk, "_default_root", None)
+            if root is not None:
+                r, g, b = root.winfo_rgb(h)
+                return (r >> 8, g >> 8, b >> 8)
+        except Exception:
+            pass
+    if h and h != PAL.get("bg"):               # last resort: theme background
+        return hex2rgb(PAL["bg"])
+    return (5, 7, 15)
 
 
 def rgb2hex(c):
diff --git a/tests/test_gui_smoke.py b/tests/test_gui_smoke.py
new file mode 100644
index 0000000..d932021
--- /dev/null
+++ b/tests/test_gui_smoke.py
@@ -0,0 +1,46 @@
+# -*- coding: utf-8 -*-
+"""GUI regression: widgets must survive Windows-style system colour names (e.g. 'SystemButtonFace')."""
+import os
+import sys
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+pytest.importorskip("PIL")
+tk = pytest.importorskip("tkinter")
+
+
+def test_hex2rgb_accepts_names_and_short_hex():
+    import pcap_glass_ui as G
+    assert G.hex2rgb("#05070f") == (5, 7, 15)
+    assert G.hex2rgb("#abc") == (170, 187, 204)
+    assert len(G.hex2rgb("SystemButtonFace")) == 3      # must not raise
+    assert len(G.hex2rgb("")) == 3
+
+
+def test_gui_redraw_with_system_colour_names():
+    try:
+        root = tk.Tk()
+        root.destroy()
+    except tk.TclError:
+        pytest.skip("no display")
+    import pcap_analyzer as P
+    errs = []
+    P.PcapAnalyzerApp.report_callback_exception = lambda self, *a: errs.append(a)
+    orig = tk.Misc.cget
+    sim = [False]
+    tk.Misc.cget = lambda self, k: "SystemButtonFace" if sim[0] and k in ("bg", "background") else orig(self, k)
+    try:
+        app = P.PcapAnalyzerApp(None)
+        app.geometry("1100x760")
+        for _ in range(20):
+            app.update()
+        sim[0] = True
+        app.geometry("1250x820")
+        for k in range(7):
+            app.goto_page(k)
+            for _ in range(5):
+                app.update()
+        app.destroy()
+    finally:
+        tk.Misc.cget = orig
+    assert not errs, errs[0]
